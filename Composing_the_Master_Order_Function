function applyDiscount(total, discountCallback) {
    return discountCallback(total);
}

function studentDiscount(total) {
    return total * 0.90; // 10% discount
}

function seniorDiscount(total) {
    return total * 0.80; // 20% discount
}

console.log(applyDiscount(100, studentDiscount));
console.log(applyDiscount(100, seniorDiscount));


// Combining all individual helper functions into a single transaction process.
// Creating a main function named calculateFinalBill that accepts three parameters: price, quantity, and discountCallback.
function calculateFinalBill(price, quantity, discountCallback) {
    // Inside (calculateFinalBill), Using calculatePrice to get the subtotal.
    const subtotal = calculatePrice(price, quantity);
    // Using applyDiscount with the provided discountCallback to get the discounted price.
    const discountedPrice = applyDiscount(subtotal, discountCallback);
    // Using getTax (with a rate of 0.07) on the discounted price to get the tax amount.
    const taxAmount = getTax(discountedPrice, 0.07);
    // Returning the grand total (discounted price + tax amount).
    return discountedPrice + taxAmount;
}
